# Public Supabase connection settings.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only; never prefix this key with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# mock is the default; select gemini or ollama to use another provider.
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Optional metadata API settings.
S2_API_KEY=your-semantic-scholar-api-key
CONTACT_EMAIL=you@example.com

# Per-user request limits. Override defaults; set a window to 0 to disable it.
# RATE_LIMIT_ASK_PER_MIN=20
# RATE_LIMIT_ASK_PER_DAY=200
# RATE_LIMIT_SUMMARY_PER_MIN=30
# RATE_LIMIT_EXPLAIN_PER_MIN=30
# RATE_LIMIT_IMPORT_PER_MIN=10
# RATE_LIMIT_IMPORT_PER_DAY=100
# RATE_LIMIT_PROCESS_PER_MIN=5
