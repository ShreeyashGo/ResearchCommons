{
  "name": "research-commons",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "set -a && . ./.env.local && set +a && RLS_TESTS=1 vitest run tests/rls/rls.smoke.test.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "env:local": "bash scripts/env-local.sh",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "pdfjs-dist": "5.4.296",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "happy-dom": "^20.0.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
